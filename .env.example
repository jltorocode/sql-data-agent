# Copy to .env.local.
ANTHROPIC_API_KEY=

# The connection the agent uses: the read-only role created by `npm run db:setup`.
DATABASE_URL=postgres://agent_reader:reader@localhost:5432/sql_agent_demo

# Only for `npm run db:setup`: a role that can create databases and roles.
# With the included docker-compose.yml: postgres://postgres:postgres@localhost:5433/postgres
ADMIN_DATABASE_URL=postgres://localhost:5432/postgres
# READER_PASSWORD=reader

# Optional
CLAUDE_MODEL=claude-opus-5-5
# low | medium (default) | high
CLAUDE_EFFORT=medium
